{
 "absolute_value": 0,
 "align_labels_right": 0,
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Financial Report Dashboard",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-orientation\" content=\"Landscape\" />\n{% set letter_head = frappe.db.get_value(\"Letter Head\",\"JGB\",['image']) %}\n<br><img src=\"{{ letter_head or '' }}\" style=\"max-height:60px\" />\n<h4 style=\"text-align:center\"><b>Project Profitability</b></h4>\n<h4 style=\"text-align:center\"><b>{{ doc.company }}</b></h4>\n<h5 style=\"text-align:center\">{{ frappe.utils.format_date(doc.from_date) }} to {{ frappe.utils.format_date(doc.to_date) }}</h5>\n{% set data = frd_report(doc) %}\n<table style=\"width:100%;border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:7px;table-layout:fixed;\">\n<thead>\n<tr>\n{% for h in data.headers %}\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:4px 1px;border:1px solid #1F3864;font-size:7px;word-wrap:break-word;width:{{ data.widths[loop.index0] }}\">{{ h }}</th>\n{% endfor %}\n</tr>\n</thead>\n<tbody>\n{% for r in data.rows %}\n{% if r.total %}\n<tr>\n{% for c in r.cells %}\n<td style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:{% if loop.index0 < 4 %}left{% else %}right{% endif %};padding:3px 1px;border:1px solid #1F3864;font-size:8px;word-wrap:break-word\">{{ c }}</td>\n{% endfor %}\n</tr>\n{% elif r.unallocated %}\n<tr>\n{% for c in r.cells %}\n<td style=\"background:#F2F2F2;color:#555555;font-style:italic;text-align:{% if loop.index0 < 4 %}left{% else %}right{% endif %};padding:2px 1px;border:1px solid #D0D0D0;word-wrap:break-word\">{{ c }}</td>\n{% endfor %}\n</tr>\n{% else %}\n<tr>\n{% for c in r.cells %}\n<td style=\"text-align:{% if loop.index0 < 4 %}left{% else %}right{% endif %};padding:2px 1px;border:1px solid #D0D0D0;word-wrap:break-word;{% if loop.index0 == 13 %}color:{% if r.eva_positive %}#1a7f37{% else %}#c0392b{% endif %};font-weight:bold;{% endif %}\">{{ c }}</td>\n{% endfor %}\n</tr>\n{% endif %}\n{% endfor %}\n</tbody>\n</table>",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
 "margin_top": 15.0,
 "module": "JGB",
 "name": "Project Profitability Dashboard",
 "page_number": "Hide",
 "pdf_generator": "wkhtmltopdf",
 "print_format_builder": 0,
 "print_format_builder_beta": 0,
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "show_section_headings": 0,
 "standard": "No"
}