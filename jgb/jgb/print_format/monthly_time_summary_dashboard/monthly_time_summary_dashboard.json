 "html": "<meta name=\"pdfkit-orientation\" content=\"Landscape\" />\n{% set letter_head = frappe.db.get_value(\"Letter Head\",\"JGB\",['image']) %}\n<br><img src=\"{{ letter_head or '' }}\" style=\"max-height:60px\" />\n<h4 style=\"text-align:center\"><b>Monthly Time Summary</b></h4>\n<h4 style=\"text-align:center\"><b>{{ doc.company }}</b></h4>\n<h5 style=\"text-align:center\">{{ frappe.utils.format_date(doc.from_date) }} to {{ frappe.utils.format_date(doc.to_date) }}{% if doc.employee %} &nbsp;|&nbsp; {{ doc.employee }}{% endif %}</h5>\n{% set data = ard_report(doc) %}\n<p style=\"font-family:Calibri,Arial,sans-serif;font-size:6.5px;color:#555;margin:4px 0;\">\n<b>HH:MM / HH:MM</b> = First / Last check-in (<span style='color:#318AD8'><b>&ge;9h</b></span>, <span style='color:#e67e22'><b>&lt;9h</b></span>) &nbsp;|&nbsp;\n<span style=\"color:#1a7f37\"><b>P</b></span> Present &nbsp;\n<span style=\"color:#c0392b\"><b>A</b></span> Absent &nbsp;\n<span style=\"color:#e67e22\"><b>HD</b></span> Half Day &nbsp;\n<span style=\"color:#318AD8\"><b>L</b></span> On Leave &nbsp;\n<span style=\"color:#1a7f37\"><b>WFH</b></span> Work From Home &nbsp;\n<span style=\"color:#8d99ae\"><b>H / WO</b></span> Holiday / Weekly Off\n</p>\n<table style=\"width:100%;border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:6.5px;table-layout:fixed;\">\n<thead>\n<tr>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:left;padding:3px 2px;border:1px solid #1F3864;width:13%\">Employee</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:left;padding:3px 2px;border:1px solid #1F3864;width:6%\">Dept.</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:left;padding:3px 2px;border:1px solid #1F3864;width:5%\">Region</th>\n{% for d in data.dates %}\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:3px 0;border:1px solid #1F3864\">{{ d.num }}<br/>{{ d.dow }}</th>\n{% endfor %}\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:3px 0;border:1px solid #1F3864;width:4%\">Tot<br/>Hrs</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:3px 0;border:1px solid #1F3864;width:3%\">P</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:3px 0;border:1px solid #1F3864;width:3%\">A</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:3px 0;border:1px solid #1F3864;width:3%\">L</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:3px 0;border:1px solid #1F3864;width:3.5%\">H/<br/>WO</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:3px 0;border:1px solid #1F3864;width:3.5%\">Unm</th>\n</tr>\n</thead>\n<tbody>\n{% for r in data.rows %}\n<tr>\n<td style=\"padding:2px;border:1px solid #D0D0D0;word-wrap:break-word\"><b>{{ r.employee_name }}</b><br/><span style=\"color:#666\">{{ r.employee }}</span></td>\n<td style=\"padding:2px;border:1px solid #D0D0D0;word-wrap:break-word\">{{ r.department }}</td>\n<td style=\"padding:2px;border:1px solid #D0D0D0;word-wrap:break-word\">{{ r.region }}</td>\n{% for c in r.cells %}\n<td style=\"padding:2px 0;border:1px solid #D0D0D0;text-align:center;word-wrap:break-word;{% if c.cls == 't9' %}color:#318AD8;font-weight:bold;{% elif c.cls == 't' %}color:#e67e22;font-weight:bold;{% elif c.cls == 'p' %}color:#1a7f37;font-weight:bold;{% elif c.cls == 'a' %}color:#c0392b;font-weight:bold;{% elif c.cls == 'hd' %}color:#e67e22;font-weight:bold;{% elif c.cls == 'l' %}color:#318AD8;font-weight:bold;{% elif c.cls == 'off' %}color:#8d99ae;{% endif %}\">{% if c.cls in ('t', 't9') %}{{ c.in }}{% if c.out %}<br/>{{ c.out }}{% endif %}{% else %}{{ c.text }}{% endif %}</td>\n{% endfor %}\n<td style=\"padding:2px 0;border:1px solid #D0D0D0;text-align:center;font-weight:bold;background:#D9E1F2\">{{ r.total_hours }}</td>\n<td style=\"padding:2px 0;border:1px solid #D0D0D0;text-align:center;font-weight:bold;background:#D9E1F2\">{{ r.present }}</td>\n<td style=\"padding:2px 0;border:1px solid #D0D0D0;text-align:center;font-weight:bold;background:#D9E1F2\">{{ r.absent }}</td>\n<td style=\"padding:2px 0;border:1px solid #D0D0D0;text-align:center;font-weight:bold;background:#D9E1F2\">{{ r.leave }}</td>\n<td style=\"padding:2px 0;border:1px solid #D0D0D0;text-align:center;font-weight:bold;background:#D9E1F2\">{{ r.holiday }}</td>\n<td style=\"padding:2px 0;border:1px solid #D0D0D0;text-align:center;font-weight:bold;background:#D9E1F2\">{{ r.unmarked }}</td>\n</tr>\n{% endfor %}\n</tbody>\n</table>",
 "idx": 0,
 "line_breaks": 0,
