 "html": "{% set letter_head = frappe.db.get_value(\"Letter Head\",\"JGB\",['image']) %}\n<br><img src=\"{{ letter_head or '' }}\" style=\"max-height:60px\" />\n<h4 style=\"text-align:center\"><b>Individual Time Summary</b></h4>\n<h4 style=\"text-align:center\"><b>{{ doc.company }}</b></h4>\n<h5 style=\"text-align:center\">{{ frappe.utils.format_date(doc.from_date) }} to {{ frappe.utils.format_date(doc.to_date) }}</h5>\n{% set data = ard_report(doc) %}\n{% set e = data.employee %}\n<table style=\"width:80%;border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:10px;margin:6px 0;\">\n<tr>\n<td style=\"padding:3px 6px;font-weight:bold;color:#1F3864;width:18%\">Employee</td>\n<td style=\"padding:3px 6px\">{{ e.id }} \u2014 {{ e.name }}</td>\n<td style=\"padding:3px 6px;font-weight:bold;color:#1F3864;width:16%\">Department</td>\n<td style=\"padding:3px 6px\">{{ e.department }}</td>\n</tr>\n<tr>\n<td style=\"padding:3px 6px;font-weight:bold;color:#1F3864\">Designation</td>\n<td style=\"padding:3px 6px\">{{ e.designation }}</td>\n<td style=\"padding:3px 6px;font-weight:bold;color:#1F3864\">Region</td>\n<td style=\"padding:3px 6px\">{{ e.region }}</td>\n</tr>\n</table>\n<table style=\"width:80%;border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:9px;margin:6px 0;table-layout:fixed;\">\n<tr>\n{% for lbl, val in [(\"TOTAL HOURS\", data.totals.total_hours), (\"LUNCH BREAK\", data.totals.lunch), (\"PRESENT\", data.totals.present), (\"ABSENT\", data.totals.absent), (\"LEAVE\", data.totals.leave), (\"HOL / WO\", data.totals.holiday), (\"UNMARKED\", data.totals.unmarked)] %}\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:4px 2px;border:1px solid #1F3864\">{{ lbl }}</th>\n{% endfor %}\n</tr>\n<tr>\n{% for lbl, val in [(\"TOTAL HOURS\", data.totals.total_hours), (\"LUNCH BREAK\", data.totals.lunch), (\"PRESENT\", data.totals.present), (\"ABSENT\", data.totals.absent), (\"LEAVE\", data.totals.leave), (\"HOL / WO\", data.totals.holiday), (\"UNMARKED\", data.totals.unmarked)] %}\n<td style=\"background:#D9E1F2;font-weight:bold;text-align:center;padding:4px 2px;border:1px solid #1F3864\">{{ val }}</td>\n{% endfor %}\n</tr>\n</table>\n<table style=\"width:100%;border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:8.5px;table-layout:fixed;\">\n<thead>\n<tr>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:left;padding:4px 6px;border:1px solid #1F3864;width:10%\">Date</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:left;padding:4px 6px;border:1px solid #1F3864;width:6%\">Day</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:4px 6px;border:1px solid #1F3864;width:8%\">In</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:4px 6px;border:1px solid #1F3864;width:8%\">Out</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:4px 6px;border:1px solid #1F3864;width:34%\">All Timings</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:4px 6px;border:1px solid #1F3864;width:9%\">Lunch</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;padding:4px 6px;border:1px solid #1F3864;width:8%\">Hours</th>\n<th style=\"background:#1F3864;color:#FFFFFF;font-weight:bold;text-align:left;padding:4px 6px;border:1px solid #1F3864\">Status</th>\n</tr>\n</thead>\n<tbody>\n{% for r in data.rows %}\n<tr>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0\">{{ r.date }}</td>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0\">{{ r.day }}</td>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0;text-align:center;color:#1F3864;font-weight:bold\">{{ r.in_time }}</td>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0;text-align:center;color:#1F3864;font-weight:bold\">{{ r.out_time }}</td>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0;text-align:center;word-wrap:break-word\">{{ r.timings }}</td>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0;text-align:center\">{{ r.lunch }}</td>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0;text-align:center;{% if r.hours != '' and r.hours|float >= 9 %}color:#318AD8;font-weight:bold;{% elif r.hours != '' %}color:#e67e22;{% endif %}\">{{ r.hours }}</td>\n<td style=\"padding:3px 6px;border:1px solid #D0D0D0;{% if r.cls == 'p' %}color:#1a7f37;font-weight:bold;{% elif r.cls == 'a' %}color:#c0392b;font-weight:bold;{% elif r.cls == 'hd' %}color:#e67e22;font-weight:bold;{% elif r.cls == 'l' %}color:#318AD8;font-weight:bold;{% elif r.cls == 'off' %}color:#8d99ae;{% elif r.cls == 'u' %}color:#e67e22;{% endif %}\">{{ r.status }}</td>\n</tr>\n{% endfor %}\n</tbody>\n</table>\n<p style=\"font-family:Calibri,Arial,sans-serif;font-size:7px;color:#555;margin-top:4px\">I = Check-in &nbsp;\u00b7&nbsp; O = Check-out &nbsp;\u00b7&nbsp; (L) = Lunch punch &nbsp;\u00b7&nbsp; Lunch = midday breaks (OUT&#8594;IN gaps and flagged lunch punches), shown as H:MM</p>",
